# Copy this file to `.env.local` and fill in the values.

# Where the contact form sends messages.
# Create a form at https://formspree.io and paste its endpoint here.
# If this is empty, the form shows a "not connected yet" message instead of sending.
NEXT_PUBLIC_FORM_ENDPOINT=

# The public address of the site. Used for the sitemap and social sharing tags.
# Leave empty during development; set it in Vercel once the domain is live.
NEXT_PUBLIC_SITE_URL=
